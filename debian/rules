#!/usr/bin/make -f
export RUSTFLAGS := $(RUSTFLAGS) --remap-path-prefix=$(CURDIR)=/usr/src/xr-system-ui
export RUSTFLAGS += --remap-path-prefix=$(abspath $(CURDIR)/..)=/usr/src/openkylin-xr
ifneq ($(strip $(CARGO_HOME)),)
export RUSTFLAGS += --remap-path-prefix=$(abspath $(CARGO_HOME))=/usr/src/cargo
endif
%:
	dh $@ --buildsystem=none
override_dh_auto_build:
	CARGO_TARGET_DIR="$(CURDIR)/target" python3 tools/build.py
override_dh_auto_test:
	@echo "System-service and scene interaction acceptance is performed in the isolated guest."
override_dh_auto_clean:
	rm -rf target build/cargo-source
